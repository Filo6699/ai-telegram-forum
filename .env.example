# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Numeric id of the forum supergroup (with "Topics" enabled).
# Tip: add the bot, send any message, and read chat.id from getUpdates — it starts with -100.
FORUM_CHAT_ID=-1001234567890

# Your own numeric Telegram user id (single-user gate — everything else is ignored).
# Tip: message @userinfobot to learn it.
ALLOWED_USER_ID=111111111

# message_thread_id of the topic you name "Новая сессия" / "New session".
# Create that topic manually, send a message in it, read message_thread_id from getUpdates.
# (Messages in the General topic — thread_id undefined — are also treated as the launcher.)
LAUNCHER_THREAD_ID=2

# Default working directory used when the launcher message has no @alias or /path prefix.
DEFAULT_CWD=/home/filo/projects/default

# Named project aliases: use "@name" as a prefix in the launcher. JSON object.
PROJECTS={"myrepo":"/home/filo/projects/myrepo","site":"/home/filo/projects/site"}

# Model id for the Claude Agent SDK.
MODEL=claude-opus-4-8

# Permission mode:
#   auto   (recommended) — auto-approve only the ALLOWED_TOOLS below, deny the
#          rest, and block obviously destructive shell commands (rm -rf, mkfs,
#          curl | sh, fork bombs, ...). Never hangs waiting for input.
#   bypass — approve EVERY tool with no checks. Only use on a machine and in
#          directories you fully trust; Claude can run any command.
PERMISSION=auto

# Tools auto-approved in "auto" mode. Trim this to tighten the bot — e.g. drop
# "Bash" for a read/edit-only assistant, or drop "Write,Edit" for read-only.
ALLOWED_TOOLS=Read,Glob,Grep,Edit,Write,Bash

# Cleanup thresholds (hours). Idle topic -> closed -> deleted.
CLOSE_AFTER_HOURS=36
DELETE_AFTER_HOURS=168

# SQLite state file.
DB_PATH=./data/state.db
