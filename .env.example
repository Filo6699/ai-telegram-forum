# Credentials and machine-specific paths. Copy to .env and keep it private.
# Portable settings are in config.json (see config.example.json).

# Telegram bot token from @BotFather.
BOT_TOKEN=123456:ABC-DEF...

# Numeric id of the forum supergroup with Topics enabled (usually starts with -100).
FORUM_CHAT_ID=-1001234567890

# Your numeric Telegram user id; messages from anyone else are ignored.
ALLOWED_USER_ID=111111111

# Optional OpenRouter API key. Leave empty to hide this provider.
OPENROUTER_API_KEY=

# Local SQLite state file.
DB_PATH=./data/state.db

# Local heartbeat file; adoption refuses to run when the bot is down.
PID_PATH=./data/bot.pid
