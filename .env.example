# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Numeric id of the forum supergroup (with "Topics" enabled).
# Tip: add the bot, send any message, and read chat.id from getUpdates — it starts with -100.
FORUM_CHAT_ID=-1001234567890

# Your own numeric Telegram user id (single-user gate — everything else is ignored).
# Tip: message @userinfobot to learn it.
ALLOWED_USER_ID=111111111

# message_thread_id of the topic you name "Новая сессия" / "New session".
# Create that topic manually, send a message in it, read message_thread_id from getUpdates.
# Use "General" (the default) to launch from the General topic instead.
# Messages in General are always treated as the launcher.
LAUNCHER_THREAD_ID=General

# Default working directory used when the launcher message has no @alias or /path prefix.
DEFAULT_CWD=/home/filo/projects/default

# Named project aliases: use "@name" as a prefix in the launcher. JSON object.
PROJECTS={"myrepo":"/home/filo/projects/myrepo","site":"/home/filo/projects/site"}

# Agent used for new topics. Existing topics remember their own provider.
# `/provider codex` or `/provider claude` overrides this for the next launch.
PROVIDER=claude

# Provider-specific model defaults. The old MODEL name remains accepted as a
# fallback for CLAUDE_MODEL, so existing installations do not need a migration.
CLAUDE_MODEL=claude-opus-5
CODEX_MODEL=gpt-5.6-sol

# Codex launch presets replace the separate model/effort button grids. Object
# keys become button labels; each value chooses a model, effort, and optional
# fast service tier. `light` is accepted as an alias for Codex's `low` effort.
CODEX_PRESETS={"Light":{"model":"gpt-5.6-sol","effort":"low"},"Flash":{"model":"gpt-5.6-sol","effort":"low","fast":true},"Normal":{"model":"gpt-5.6-sol","effort":"medium"},"Decent":{"model":"gpt-5.6-sol","effort":"high"}}
CODEX_DEFAULT_PRESET=Decent

# Permission mode:
#   auto   (recommended) — Claude uses the Telegram approval flow described by
#          ALLOWED_TOOLS below. Codex runs non-interactively in its
#          workspace-write sandbox with network access.
#   bypass — approve EVERY tool with no checks. Only use on a machine and in
#          directories you fully trust; either agent can run any command.
PERMISSION=auto

# Tools auto-approved in "auto" mode. Trim this to tighten the bot — e.g. drop
# "Bash" for a read/edit-only assistant, or drop "Write,Edit" for read-only.
ALLOWED_TOOLS=Read,Glob,Grep,Edit,Write,Bash

# How long a permission prompt waits for a button press. No answer = denied.
PERMISSION_TIMEOUT_MINUTES=10

# How long a topic keeps its live session object after the last message. Claude
# keeps its child warm and accepts mid-turn input; Codex starts one subprocess
# per turn and sends messages received mid-turn as the next turn.
SESSION_IDLE_MINUTES=20

# Cleanup threshold (hours): an idle topic is deleted after this long.
DELETE_AFTER_HOURS=168

# SQLite state file.
DB_PATH=./data/state.db

# Heartbeat file the running bot keeps warm. `/telegramify` and `codexify` read
# it and refuse to adopt a session while the bot is down.
PID_PATH=./data/bot.pid
